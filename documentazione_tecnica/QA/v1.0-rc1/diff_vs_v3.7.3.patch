+<!doctype html>
+<html lang="it">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Il Secchione · Inizia qui</title>
+<style>
+body{font:17px/1.55 "Segoe UI",system-ui,Arial,sans-serif;color:#17202b;max-width:760px;margin:0 auto;padding:28px 22px;background:#fff}
+h1{font-size:30px;margin:0 0 4px}h1+p{margin-top:0;color:#475569}
