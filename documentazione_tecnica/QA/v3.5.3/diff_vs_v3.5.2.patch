+.stBrand img{width:110px;height:auto}
+.stBrand div{display:grid;gap:2px}
+.stBrand small{font-size:10px;letter-spacing:.15em;color:var(--muted)}
+.stBrand strong{color:var(--gold);font-size:15px;letter-spacing:.06em}
+.stDoc{flex:1;min-width:220px;display:grid;gap:3px}
+.stDoc b{font-size:17px;overflow-wrap:anywhere}
+.stDoc span{font-size:12px;color:var(--muted)}
+.stBarBtns{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
+.stStatus{display:grid;gap:2px;text-align:right;font-size:12px;margin-right:6px}
+.stStatus small{color:var(--muted);font-size:11px}
+
+/* schede */
+.stTabs{display:flex;gap:6px;margin:12px 0 10px;flex-wrap:wrap}
+.stTabs .tabBtn{font-size:13px;padding:10px 16px;border-radius:8px}
+.stBadge{display:inline-block;min-width:20px;padding:1px 7px;margin-left:4px;border-radius:10px;background:#0b1a2b;font-size:11px;text-align:center}
+.stBadge:empty{display:none}
+.stBadge.bad{background:#a3324a;color:#fff}
+.stBadge.good{color:#62e5ab}
+#stMsg .pkMsg{margin:0 0 10px}
+
+/* riquadri e campi */
+.stCard{border:1px solid var(--line);background:#101f30;border-radius:12px;padding:16px;min-width:0}
