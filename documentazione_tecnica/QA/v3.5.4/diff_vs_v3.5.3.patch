+/* ===== Mascotte animata v3.5.4 =====
+   4 pose reali (assets/mascot/mascot_*.webp). Si anima solo transform/opacity.
+   Unità cqh/cqw del palco: su 1920×1080 corrispondono ai px della specifica (float 5 px, salto 18 px, scossa ±6 px).
+   .mascotPlay = evento nuovo: l'animazione d'ingresso/one-shot va eseguita; senza, la posa resta ferma (o solo il moto continuo),
+   così un ridisegno del palco non ripete salti o scosse. */
+.mascotStage{pointer-events:none;user-select:none;-webkit-user-select:none}
+.publicHostMascot{pointer-events:none;user-select:none;-webkit-user-drag:none;will-change:transform}
+.mascotShadow{animation:none}
+.mascotSpark,.mood-celebrate .mascotSpark,.mood-reveal .mascotSpark{animation:none}
+/* PRESENT (welcome, reveal): ingresso 420 ms una volta, poi leggero float */
+.mood-welcome .publicHostMascot,.mood-reveal .publicHostMascot{animation:mascotFloat 2.8s ease-in-out infinite}
+.mascotPlay.mood-welcome .publicHostMascot,.mascotPlay.mood-reveal .publicHostMascot{animation:mascotIntro .42s cubic-bezier(.2,.8,.3,1) both,mascotFloat 2.8s ease-in-out .42s infinite}
+.mood-welcome .mascotShadow,.mood-reveal .mascotShadow{animation:mascotShadowFloat 2.8s ease-in-out infinite}
+/* THINK: respiro discreto, nessun scatto; anche negli ultimi 10 secondi (niente agitazione aggiuntiva) */
+.mood-think .publicHostMascot,.urgentMascot .publicHostMascot{animation:mascotThinkSoft 2.6s ease-in-out infinite}
+/* CELEBRATE: salto one-shot ~700 ms, poi posa ferma */
+.mood-celebrate .publicHostMascot{animation:none}
+.mascotPlay.mood-celebrate .publicHostMascot{animation:mascotJump .7s cubic-bezier(.25,.8,.35,1) both}
+.mascotPlay.mood-celebrate .mascotSpark{animation:sparkFlash .9s ease-out 1}
+/* PANIC (tempo scaduto): scossa one-shot ~500 ms, poi posa ferma */
+.mood-panic .publicHostMascot{animation:none}
+.mascotPlay.mood-panic .publicHostMascot{animation:mascotPanic .5s ease-in-out both}
+@keyframes mascotIntro{from{opacity:0;transform:translateY(.93cqh) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
+@keyframes mascotFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-.46cqh)}}
+@keyframes mascotShadowFloat{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(.94);opacity:.8}}
+@keyframes mascotThinkSoft{0%,100%{transform:scale(1) rotate(-.4deg)}50%{transform:scale(1.012) rotate(.4deg)}}
+@keyframes mascotJump{0%{transform:translateY(0) scale(1) rotate(0)}35%{transform:translateY(-1.7cqh) scale(1.04) rotate(-1.2deg)}65%{transform:translateY(-.4cqh) scale(1.015) rotate(.8deg)}100%{transform:translateY(0) scale(1) rotate(0)}}
+@keyframes mascotPanic{0%,100%{transform:translateX(0) rotate(0)}15%{transform:translateX(-.3cqw) rotate(-1.6deg)}30%{transform:translateX(.3cqw) rotate(1.6deg)}45%{transform:translateX(-.26cqw) rotate(-1.2deg)}60%{transform:translateX(.22cqw) rotate(1deg)}75%{transform:translateX(-.12cqw) rotate(-.5deg)}}
+/* Movimento ridotto (sistema) o animazioni spente in regia: le pose cambiano, senza movimento */
+@media (prefers-reduced-motion:reduce){.mascotStage,.mascotStage *{animation:none!important;transition:none!important}.mascotSpark{display:none}}
