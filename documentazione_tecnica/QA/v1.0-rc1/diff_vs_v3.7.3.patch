+<!doctype html>
+<html lang="it">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Il Secchione · Guida per il docente</title>
+<style>
+body{font:16px/1.6 "Segoe UI",system-ui,Arial,sans-serif;color:#17202b;max-width:860px;margin:0 auto;padding:28px 22px;background:#fff}
+h1{font-size:28px;margin:0 0 4px}h2{font-size:20px;margin:30px 0 8px;border-bottom:2px solid #e2e8f0;padding-bottom:4px}h3{font-size:16px;margin:18px 0 4px}
