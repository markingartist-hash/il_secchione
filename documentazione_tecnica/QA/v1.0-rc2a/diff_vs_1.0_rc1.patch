+/* ===== RC2-A · TASTIERA DELLE PULSANTIERE (feedback dai pilot) =====
+   5 righe a tutta altezza (lettere/numeri, accenti, comandi con INVIA), tasti alti almeno 44 px, nessuno scorrimento.
+   I numeri stanno dietro il tasto 123. Vale per telefoni e tablet, in verticale e in orizzontale. */
+.answerArea.textMode .textKeyboard.kb2{flex:1 1 auto;display:grid;grid-template-rows:repeat(5,minmax(44px,1fr));gap:clamp(4px,.8vh,8px);min-height:0}
+.textKeyboard.kb2 .kbRow{display:flex;gap:clamp(3px,.6vw,7px);min-width:0;height:auto;min-height:44px}
+.textKeyboard.kb2 .kbKey{flex:1 1 0;min-width:0;max-width:none;min-height:44px;height:auto;border-radius:10px;border-width:2px;font-size:clamp(18px,3.4vh,32px);font-weight:900;touch-action:manipulation;-webkit-user-select:none;user-select:none}
+.textKeyboard.kb2 .kbDigits{display:none}
+.textKeyboard.kb2.digits .kbDigits{display:flex}
+.textKeyboard.kb2.digits .kbLetters{display:none}
+.textKeyboard.kb2 .kbKey.back{flex:1.6 1 0;background:#24384f}
+.textKeyboard.kb2 .kbActions .kbKey{font-size:clamp(14px,2.6vh,24px);letter-spacing:.03em}
+.textKeyboard.kb2 .kbKey.mode{flex:1.1 1 0}
+.textKeyboard.kb2 .kbKey.space{flex:2.4 1 0}
+.textKeyboard.kb2 .kbKey.danger{flex:1.5 1 0}
+.textKeyboard.kb2 .kbSend{flex:2.4 1 0;margin:0;min-height:44px;border:0;border-radius:12px;background:#0b815c;color:#fff;font-size:clamp(18px,3.4vh,32px)!important;font-weight:900;letter-spacing:.08em}
+.textKeyboard.kb2 .kbSend:disabled{background:#1b3a35;color:#7fa596}
+.answerArea.textMode .textEntryBar .textDisplay{height:clamp(48px,9vh,84px);min-height:48px;font-size:clamp(26px,5.2vh,46px)}
+.done.sent{background:#0b5a3f;border-color:#62e5ab;border-width:5px}
+.done.sent .tick{color:#9dffd3}
+.done.sent h2{font-size:clamp(30px,6vh,56px)}
+.done .sentAnswer{display:inline-block;margin:1vh 0;padding:.6vh 1.4vw;border-radius:12px;background:#063a29;font-size:clamp(26px,6vh,60px);letter-spacing:.04em;word-break:break-word}
+@media (orientation:landscape) and (max-height:650px){
+ .answerArea.textMode .textKeyboard.kb2{grid-template-rows:repeat(5,minmax(40px,1fr));gap:3px}
+ .textKeyboard.kb2 .kbRow{min-height:40px;gap:3px}
+ .textKeyboard.kb2 .kbKey,.textKeyboard.kb2 .kbSend{min-height:40px;font-size:clamp(16px,4.6vh,24px)!important}
+ .answerArea.textMode .textEntryBar .textDisplay{height:42px;min-height:42px;font-size:clamp(22px,6vh,30px)}
+}
+/* RC2-A · misure dal collaudo: righe al massimo 96 px (tablet in verticale) con tastiera in basso, vicino ai pollici;
+   telefono in orizzontale: intestazione compatta per tenere i tasti alti almeno 44 px e il testo digitato grande. */
+.answerArea.textMode .textKeyboard.kb2{flex:0 1 auto;grid-template-rows:repeat(5,minmax(44px,96px))}
+.answerArea.textMode:has(.kb2){justify-content:flex-end}
+@media (orientation:landscape) and (max-height:450px){
+ .head.textHead .team{font-size:20px;line-height:1}
+ .head.textHead small{display:none}
+ .answerArea.textMode .textKeyboard.kb2{grid-template-rows:repeat(5,44px);gap:3px}
+ .textKeyboard.kb2 .kbRow{min-height:44px}
+ .textKeyboard.kb2 .kbKey,.textKeyboard.kb2 .kbSend{min-height:44px}
+ .answerArea.textMode .textEntryBar .textDisplay{height:44px;min-height:44px;font-size:28px}
+}
