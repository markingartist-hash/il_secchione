+.stGpCards figure>span{display:flex;align-items:center;justify-content:center;color:#9bb0c5;font-size:2.6cqh}
+.stGpCards figcaption{font-size:2.8cqh;padding:1cqh;text-align:center;font-weight:700;min-height:5cqh}
+.stGpPairs{display:grid;gap:1.3cqh;flex:1;align-content:center}
+.stGpPairs>div{display:grid;grid-template-columns:5cqh 1fr 1fr;gap:1.5cqw;align-items:center}
+.stGpPairs b{font-size:3.4cqh;color:#ffd258;text-align:center}
+.stGpPairs span{text-align:center;font-size:3.5cqh;font-weight:800;padding:1.2cqh;background:linear-gradient(180deg,#164d91,#0b3268);border:1px solid #478fd5;border-radius:.8cqh;text-transform:uppercase}
+.stGpPairs span.no{opacity:.35;text-decoration:line-through}
+.stGpChain{display:grid;gap:1.4cqh;align-content:center;flex:1;font-size:4cqh;font-weight:800;text-transform:uppercase}
+.stGpChain>div{display:flex;gap:1.6cqw;align-items:center;justify-content:center}
+.stGpChain em{font-style:normal;color:#8edaff}
+.stGpChain span{background:#0b3268;border:1px solid #478fd5;border-radius:.8cqh;padding:1cqh 2cqw;letter-spacing:.06em}
+
+/* finestre */
+.stModal{max-width:580px}
+.stModal h2{color:#ffd258;font-size:17px;margin-bottom:10px}
+.stModalBody{font-size:14px;line-height:1.55}
+.stModalBtns{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;margin-top:18px}
+.stModalBtns .btn{font-size:12px;padding:10px 14px}
+.stBusy{position:fixed;inset:0;background:#020b19aa;display:flex;align-items:center;justify-content:center;z-index:80}
+.stBusy[hidden]{display:none}
+.stBusy span{background:#101f30;border:1px solid #456a8b;padding:16px 22px;border-radius:10px;font-size:15px;font-weight:700}
+body.stDragging::after{content:"Rilascia qui il file";position:fixed;inset:12px;border:4px dashed #ffd258;border-radius:16px;background:#070f1bcc;color:#ffd258;font:800 28px "Segoe UI",Arial,sans-serif;display:flex;align-items:center;justify-content:center;z-index:100;pointer-events:none}
+
+@media(max-width:1300px){
+  .stThree{grid-template-columns:270px minmax(0,1fr)}
+  .stPreviewCol{grid-column:1/-1;position:static;max-width:760px}
+  .stStartGrid{grid-template-columns:1fr 1fr}
+  .stCardLib{grid-column:1/-1}
+}
+@media(max-width:900px){
+  .stThree,.stInfo,.stCheck,.stStartGrid{grid-template-columns:1fr}
+  .stList{position:static;max-height:none}
+  .stListScroll{max-height:45vh}
+  .stRow2,.stRow3,.stCards,.stSaveBtns{grid-template-columns:1fr}
+  .stPicker,.stCardSlot .stPicker{grid-template-columns:110px minmax(0,1fr)}
+  .stStatus{text-align:left}
+  .stApp{padding:12px 16px 40px}
+}
+@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
