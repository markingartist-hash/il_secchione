+    TM: { secondsFor: function () { return 30; } }, SS: SS, cloneAudio: function () {}, setTimeout: function () {}, arcadeEpoch: 0, commitQuestionScores: function () {}, fillMissingAbstain: function () {}, closeQuestionTime: function () {}
