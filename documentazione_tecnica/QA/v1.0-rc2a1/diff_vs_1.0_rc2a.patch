diff -ruN '--exclude=QA' '--exclude=SHA256SUMS.txt' '--exclude=runtime' '--exclude=RELEASE.json' '--exclude=legacy_v3' Il_Secchione_1.0_RC2A_POST_PILOT/tests/rc2a1_hotfix.test.js Il_Secchione_1.0_RC2A1_HOTFIX/tests/rc2a1_hotfix.test.js
