+.stCard h3{font-size:13px;margin:14px 0 6px}
+.stCard h3 small{font-weight:400;color:var(--muted)}
+.stField{display:grid;gap:5px;margin:0 0 13px;min-width:0}
+.stField>span{font-size:12.5px;font-weight:700;color:#cfe3f3}
+.stField>span small{font-weight:400;color:var(--muted)}
+.stHelp{color:#9bb0c5;font-size:11.5px;line-height:1.4}
+.stInputWrap{display:block;position:relative;min-width:0}
+.stCount{position:absolute;right:9px;bottom:6px;font-size:10px;color:#6f8aa3;pointer-events:none}
+.stBig{font-size:16px!important}
+.stRow2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
+.stRow3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
+.stInline{display:flex;gap:6px;align-items:center}
+.stInline .stInputWrap,.stInline>input{flex:1}
+.stInline em{font-style:normal;color:var(--muted);font-size:12px}
+.stColor{width:100%;height:40px;border:1px solid #37506a;border-radius:7px;background:#091625;padding:2px;cursor:pointer}
