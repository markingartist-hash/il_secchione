+/* Il Secchione · PACK STUDIO — si appoggia a show.css (palette, pulsanti, palco) e classroom.css (messaggi) */
+
+.studioPage{background:#070f1b}
+.stApp{max-width:1760px;margin:auto;padding:14px 18px 48px;color:#edf6ff}
+.stApp .control{font-size:14px;padding:9px 10px}
+.stApp textarea.control{resize:vertical;line-height:1.4;display:block}
+.stApp .btn{font-size:12px}
+.stApp .btn.tiny{font-size:11px;padding:5px 8px}
+.stApp .help{font-size:12.5px}
+.warn{color:#ffd258}
+.top8{margin-top:8px}.top16{margin-top:20px}
+code{font-family:Consolas,monospace;font-size:.92em;color:#c9e6ff}
+
+/* intestazione */
+.stHeader{display:flex;align-items:center;gap:18px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:12px}
