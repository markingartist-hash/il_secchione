+
+/* ===== v3.7.3 · CLASSIFICA FINALE: proclamazione dalla posizione piu bassa alla prima =====
+   Stessa grammatica della classifica del round (resultHeader, resultPos, toni del podio); qui ogni AVANTI rivela una posizione.
+   Animazioni solo transform/opacity; con movimento ridotto le carte compaiono senza animazione. */
+.finalScene{height:100%;padding:2.4cqh 3.1cqw 2.6cqh;display:grid;grid-template-rows:10.5cqh minmax(0,1fr);gap:1.8cqh;position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% -12%,#1679ff5c 0,transparent 50%),radial-gradient(ellipse at 50% 118%,#ffbd3338 0,transparent 44%),linear-gradient(150deg,#071f4a,#030b1c)}
+.finalScene.complete{background:radial-gradient(ellipse at 50% -12%,#1679ff5c 0,transparent 50%),radial-gradient(ellipse at 50% 112%,#ffc63e55 0,transparent 48%),linear-gradient(150deg,#071f4a,#030b1c)}
+.finalHeader .revealDirection strong{font-variant-numeric:tabular-nums}
+.finalIntro{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:2cqh;min-height:0;animation:finalIntroIn .9s cubic-bezier(.2,.8,.25,1) both}
+.finalKicker{font-size:2.2cqh;letter-spacing:.34em;color:#9fd2ff;font-weight:900}
+.finalIntro h2{margin:0;font-size:12cqh;line-height:.92;letter-spacing:-.025em;color:#fff;text-shadow:0 0 5cqh #2f8cff70}
+.finalIntro p{margin:0;font-size:4cqh;color:#ffe08a;font-weight:800}
+.finalIntro small{font-size:2.1cqh;color:#9fbcd6;letter-spacing:.08em}
+.finalList{display:grid;gap:1.1cqh;min-height:0;padding:0 .4cqw}
+.finalCard{--tone:#4a8bd3;position:relative;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:2cqw;min-height:0;padding:.9cqh 2.2cqw .9cqh 1.6cqw;border:1px solid color-mix(in srgb,var(--tone) 70%,#1c3651);border-left:.8cqh solid var(--tone);border-radius:1.4cqh;background:linear-gradient(100deg,#0d315c 0,#091d39 70%,#07172d 100%);box-shadow:0 .5cqh 2cqh #0006,inset 0 0 2cqh #ffffff05;overflow:hidden}
+.finalCard .resultPos{width:8cqh;height:8cqh;font-size:3.5cqh;font-weight:900}
+.finalIdentity{min-width:0;display:flex;flex-direction:column;justify-content:center;gap:.7cqh}
+.finalTeam{font-size:4.8cqh;font-weight:900;line-height:1.2;padding-bottom:.04em;color:#fff;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
+.finalIdentity small{display:flex;flex-wrap:wrap;align-items:center;gap:.4cqh 1.4cqw;font-size:1.9cqh;color:#a9cbe4;font-weight:800;letter-spacing:.04em}
+.finalIdentity .medal{font-style:normal;color:var(--tone);letter-spacing:.18em;font-weight:900}
+.finalIdentity .tie{font-style:normal;color:#ffe08a;letter-spacing:.12em}
+.finalScore{display:flex;flex-direction:column;align-items:flex-end;justify-content:center}
+.finalScore strong{font-size:6.4cqh;line-height:1;color:#fff;font-variant-numeric:tabular-nums;white-space:nowrap}
+.finalScore span{font-size:1.5cqh;letter-spacing:.22em;color:#8fb7d5;font-weight:900}
+.finalCard.p1{--tone:#ffd34c;border-color:#ffe58a;border-left-color:#ffe58a;background:linear-gradient(100deg,#8a6512 0,#1d3a55 68%,#081a31 100%);box-shadow:0 0 5cqh #ffd34c40,0 .6cqh 2.4cqh #0008}
+.finalCard.p1 .resultPos{background:#d4a72e;color:#152034;border-color:#fff0ad;font-size:4.2cqh}
+.finalCard.p1 .finalScore strong{color:#ffe58a}
+.finalCard.p2{--tone:#d3e1ec;background:linear-gradient(100deg,#40536a 0,#122c49 70%,#081a31 100%);box-shadow:0 0 3cqh #d3e1ec22,0 .5cqh 2cqh #0007}
+.finalCard.p3{--tone:#e0a26f;background:linear-gradient(100deg,#5b3b22 0,#142b47 70%,#081a31 100%);box-shadow:0 0 3cqh #e0a26f22,0 .5cqh 2cqh #0007}
+.finalCard.locked{grid-template-columns:auto minmax(0,1fr);background:#071a31b0;border-style:dashed;border-left-style:solid;box-shadow:none;opacity:.6}
+.finalCard.locked.podium{opacity:.72}
+.finalLock{font-size:4cqh;color:#4f7aa3;font-weight:900;letter-spacing:.4em}
+.finalShine{position:absolute;top:0;bottom:0;left:-30%;width:24%;background:linear-gradient(100deg,transparent,#fff4 50%,transparent);opacity:0;pointer-events:none}
+.finalCard.enter{animation:finalCardIn .6s cubic-bezier(.18,.84,.25,1) both}
+.finalCard.podium.enter{animation-duration:.85s}
+.finalCard.p1.enter{animation:finalWinnerIn 1.15s cubic-bezier(.16,.9,.24,1) both}
+.finalCard.p1.enter .finalShine{animation:finalShine 1.5s .55s ease-out both}
+@keyframes finalCardIn{from{opacity:0;transform:translateY(3cqh)}to{opacity:1;transform:none}}
+@keyframes finalWinnerIn{0%{opacity:0;transform:translateY(5cqh) scale(.88)}60%{opacity:1;transform:translateY(-.8cqh) scale(1.035)}100%{opacity:1;transform:none}}
+@keyframes finalShine{0%{opacity:0;transform:translateX(0)}20%{opacity:1}100%{opacity:0;transform:translateX(600%)}}
+@keyframes finalIntroIn{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:none}}
+/* poche squadre: carte ancora piu grandi; 6-8 squadre: carte piu basse ma sempre leggibili */
+.finalScene.few .finalCard .resultPos{width:11cqh;height:11cqh;font-size:4.6cqh}
+.finalScene.few .finalTeam{font-size:6.6cqh}
+.finalScene.few .finalScore strong{font-size:8.6cqh}
+.finalScene.few .finalIdentity small{font-size:2.3cqh}
+.finalScene.dense .finalList{gap:.8cqh}
+.finalScene.dense .finalCard{padding:.45cqh 2cqw .45cqh 1.4cqw}
+.finalScene.dense .finalCard .resultPos{width:6.2cqh;height:6.2cqh;font-size:2.8cqh}
+.finalScene.dense .finalTeam{font-size:3.7cqh;-webkit-line-clamp:1}
+.finalScene.dense .finalScore strong{font-size:4.8cqh}
+.finalScene.dense .finalIdentity small{font-size:1.85cqh}
+.finalScene.dense .finalLock{font-size:3cqh}
+/* molte squadre (oltre 8): podio 2-1-3 grande in alto, le altre in colonne compatte */
+.finalMany{display:grid;grid-template-rows:minmax(0,1.2fr) minmax(0,1fr);gap:1.6cqh;min-height:0}
+.finalPodium{display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:1.6cqw;align-items:end;min-height:0}
+.finalPodium .finalCard{height:100%;grid-template-columns:1fr;justify-items:center;align-content:center;text-align:center;gap:.9cqh;padding:1.2cqh 1.4cqw}
+.finalPodium .finalCard:nth-child(1){height:86%}
+.finalPodium .finalCard:nth-child(3){height:76%}
+.finalPodium .finalIdentity small{justify-content:center}
+.finalPodium .finalScore{align-items:center}
+.finalPodium .finalTeam{font-size:3.9cqh}
+.finalPodium .finalCard.p1 .finalTeam{font-size:4.6cqh}
+.finalPodium .finalScore strong{font-size:5.2cqh}
+.finalPodium .finalCard .resultPos{width:7cqh;height:7cqh;font-size:3cqh}
+.finalRest{display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));grid-template-rows:repeat(var(--rows),minmax(0,1fr));grid-auto-flow:column;gap:.7cqh 1.4cqw;min-height:0}
+.finalRest .finalCard{padding:.3cqh 1.2cqw .3cqh .9cqw;gap:1.1cqw;border-left-width:.5cqh;border-radius:1cqh}
+.finalRest .finalCard .resultPos{width:4.3cqh;height:4.3cqh;font-size:1.9cqh}
+.finalRest .finalTeam{font-size:2.5cqh;-webkit-line-clamp:1}
+.finalRest .finalIdentity{gap:.2cqh}
+.finalRest .finalIdentity small{font-size:1.5cqh}
+.finalRest .finalScore strong{font-size:3cqh}
+.finalRest .finalScore span{font-size:.95cqh}
+.finalRest .finalLock{font-size:2.3cqh}
+@media(prefers-reduced-motion:reduce){.finalCard.enter,.finalCard.p1.enter,.finalIntro,.finalCard.p1.enter .finalShine{animation:none!important}}
+.finalScene.isIntro .resultHeader h1{visibility:hidden}
