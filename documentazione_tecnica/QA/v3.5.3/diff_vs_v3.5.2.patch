+.stDetails textarea{margin-top:6px}
+
+/* scelta immagine */
+.stPicker{display:grid;grid-template-columns:150px minmax(0,1fr);gap:10px;align-items:start;background:#0b1a2b;border:1px dashed #37506a;border-radius:8px;padding:8px}
